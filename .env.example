# Copy to .env and fill in. Never commit the real .env.

PORT=3000
# Public origin used to build signing links. Must be the URL recipients can reach.
BASE_URL=http://localhost:3000

# Generate each of these with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. In development a value is generated into .secrets/ if these are unset.
SESSION_SECRET=
# Encrypts stored SMTP passwords. Changing it makes existing saved SMTP passwords unreadable.
APP_KEY=

# Where the SQLite database and PDFs live.
STORAGE_DIR=./storage
DB_PATH=./storage/signflow.db
MAX_UPLOAD_BYTES=26214400

# Shown on the certificate and in the privacy notice. Change if you host elsewhere.
DATA_REGION=South Africa (af-south-1, Cape Town)
DATA_REGION_SHORT=South Africa
DISPLAY_TZ=Africa/Johannesburg

# Provenance line printed along the bottom of every page of a sealed document.
# Set PAGE_FOOTER=off for source files whose content reaches the page edge,
# where it would overlap rather than sit in the margin.
# PAGE_FOOTER=off
# PAGE_FOOTER_TEXT=Signed via {brand}   ·   Document {id}

# Your own details. These appear on the certificate and in the footer — leave the
# legal ones blank until they are true of your business.
BRAND_NAME=SignFlow
BRAND_LEGAL_NAME=
BRAND_REG_NO=
BRAND_ADDRESS=
BRAND_INFORMATION_OFFICER=
BRAND_POPIA_REG_NO=

# Set to the number of proxy hops in front of the app (e.g. 1 behind nginx).
# Leave unset when the app is exposed directly, or clients can spoof the IP on the audit trail.
# TRUST_PROXY=1

# NODE_ENV=production
