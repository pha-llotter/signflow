<%- include('partials/head', { title: 'Create account' }) %>
<%- include('partials/nav') %>

<main>
  <div class="auth card">
    <h1>Create the administrator</h1>
    <p class="sub">
      This is the first account on this installation. It becomes the administrator, and everyone
      after it joins by invitation.
    </p>

    <% if (error) { %><div class="notice notice-bad" style="margin-top:0"><%= error %></div><% } %>

    <form method="post" action="/register" style="margin-top:18px">
      <div class="field">
        <label for="display_name">Your name</label>
        <input id="display_name" name="display_name" type="text" value="<%= values.display_name || '' %>" required autofocus>
      </div>
      <div class="field">
        <label for="org_name">Organisation <span style="font-weight:400;color:var(--ink-3)">(optional)</span></label>
        <input id="org_name" name="org_name" type="text" value="<%= values.org_name || '' %>">
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" value="<%= values.email || '' %>" required autocomplete="username">
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" required minlength="10" autocomplete="new-password">
        <p class="hint">At least 10 characters. Stored hashed with Argon2id — never in the clear.</p>
      </div>
      <button class="btn" type="submit" style="width:100%">Create administrator account</button>
    </form>

    <p class="hint" style="margin-top:18px">Already have an account? <a href="/login">Sign in</a>.</p>
  </div>
</main>

<%- include('partials/foot') %>
