<%- include('partials/head', { title: 'Sign · ' + doc.title }) %>

<header class="topbar">
  <span class="brand"><img src="/static/brand/logo-web.png?v=<%= v %>" alt="<%= brand.name %>" width="98" height="22"></span>
  <nav style="margin-right:auto"><span class="hint"><%= doc.title %></span></nav>
  <span class="who">Signing as <%= recipient.name %></span>
  <%- include('partials/theme-toggle') %>
</header>
<script src="/static/js/theme.js?v=<%= v %>" defer></script>

<%#
  The document takes the full width. What used to be a side panel is now:
  a welcome popup (who is asking, the message, what signing records, consent),
  this action bar (progress, next field, finish), and a confirmation popup.
  On a phone the bar moves to the bottom of the screen, within thumb reach.
%>
<div class="sign-bar" id="sign-bar">
  <div class="sign-bar-inner">
    <span class="sign-progress">
      <strong id="done-count">0</strong> of <%= myFields.length %> field<%= myFields.length === 1 ? '' : 's' %> done
    </span>
    <button type="button" class="link-btn sign-decline" id="decline-btn">Decline</button>
    <button type="button" class="btn btn-ghost btn-sm" id="next-btn">Next field</button>
    <button type="button" class="btn btn-sm" id="finish-btn" disabled>Finish</button>
  </div>
  <div id="sign-error" class="notice notice-bad sign-error" hidden></div>
</div>

<div class="sign-doc">
  <div id="pages"></div>
  <aside class="sign-pages" aria-label="Pages">
    <h3>Pages</h3>
    <div class="thumbs" id="sign-thumbs"></div>
    <p class="sign-pages-key"><span class="key todo"></span>To do <span class="key done"></span>Done</p>
  </aside>
</div>

<%# Shown on arrival, before anything can be filled in: consent comes first. %>
<div class="modal-back" id="welcome" role="dialog" aria-modal="true" aria-labelledby="welcome-h">
  <div class="modal welcome">
    <h2 id="welcome-h">Review &amp; sign</h2>
    <p class="sub">
      <strong><%= owner.display_name %></strong><% if (owner.org_name) { %> (<%= owner.org_name %>)<% } %>
      has asked you to sign <strong><%= doc.title %></strong>.
    </p>
    <% if (doc.message) { %>
      <div class="welcome-message"><%= doc.message %></div>
    <% } %>

    <div class="welcome-terms">
      <strong>Before you sign</strong>
      Signing this records your name, email address, IP address, browser and the time of every step, and seals
      that record to the document with a SHA-256 hash. It is kept as evidence that you signed, and stored in
      <%= dataRegion %>. This is processed under the Electronic Communications and Transactions Act and POPIA.
      Your location is never taken.
    </div>

    <label class="check welcome-consent">
      <input type="checkbox" id="consent">
      <span>I agree to sign this document electronically, and to the record described above being kept.</span>
    </label>

    <div class="btn-row welcome-actions">
      <button type="button" class="link-btn" id="welcome-decline">Decline to sign</button>
      <button type="button" class="btn" id="welcome-continue" disabled>Continue</button>
    </div>
    <p class="hint welcome-fine">This link is unique to you. Do not forward it — anyone holding it can sign in your name.</p>
  </div>
</div>

<form method="post" action="/sign/<%= token %>/decline" id="decline-form" hidden>
  <input type="hidden" name="reason" id="decline-reason">
</form>

<script>
  window.__SIGN__ = {
    token: <%- JSON.stringify(token) %>,
    title: <%- JSON.stringify(doc.title) %>,
    pdfUrl: <%- JSON.stringify('/sign/' + token + '/document.pdf') %>,
    recipientId: <%- JSON.stringify(recipient.id) %>,
    recipientName: <%- JSON.stringify(recipient.name) %>,
    recipientEmail: <%- JSON.stringify(recipient.email) %>,
    fields: <%- JSON.stringify(fields) %>,
    fieldTypes: <%- JSON.stringify(fieldTypes) %>
  };
</script>
<script type="module" src="/static/js/sign.js?v=<%= v %>"></script>
</body>
</html>
