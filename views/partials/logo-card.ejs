<%# A company's logo: preview, upload and remove. `c` is the company; `base` is the URL the forms post under. %>
<div class="card">
  <h2>Logo</h2>
  <p class="hint">
    Printed at the top of every certificate <%= c.name %> seals, shown at the top of its emails and in the sidebar.
    PNG or JPG, up to 1 MB — a few hundred KB is plenty, since it is embedded in every certificate. A wide logo on a
    transparent background reads best.
  </p>
  <% if (c.logo_path) { %>
    <div class="logo-preview">
      <img src="/company-logo/<%= c.id %>?v=<%= encodeURIComponent(c.logo_updated_at || '') %>" alt="<%= c.name %> logo">
      <span class="hint"><%= c.logo_width %> × <%= c.logo_height %> px</span>
    </div>
  <% } %>
  <form method="post" action="<%= base %>/logo" enctype="multipart/form-data" class="logo-form">
    <input type="file" name="logo" accept="image/png,image/jpeg" required aria-label="Logo image">
    <button class="btn btn-sm" type="submit"><%= c.logo_path ? 'Replace logo' : 'Upload logo' %></button>
  </form>
  <% if (c.logo_path) { %>
    <form method="post" action="<%= base %>/logo/remove" style="margin-top:8px">
      <button class="link-btn" type="submit">Remove logo</button>
    </form>
    <p class="hint">Certificates already sealed keep the logo they were sealed with.</p>
  <% } %>
</div>
