<div class="pub">
  <%- include('support-banner') %>
  <header class="pub-bar">
    <%# Signed in, the logo goes to your own work; signed out, to the public
        verification page at the root. %>
    <a class="brand" href="<%= user ? '/dashboard' : '/' %>">
      <img src="/static/brand/logo-web.png?v=<%= v %>" alt="<%= brand.name %>" width="98" height="22">
    </a>
    <nav>
      <% if (user) { %>
        <a href="/dashboard">Dashboard</a>
      <% } else { %>
        <a href="/login">Sign in</a>
      <% } %>
    </nav>
    <%- include('theme-toggle') %>
  </header>

  <% if (typeof flash !== 'undefined' && flash) { %>
    <div class="wrap"><div class="flash flash-<%= flash.type %>"><%= flash.text %></div></div>
  <% } %>

