<%# The SMTP form, shared by an organisation's own mail and the platform default. `s` is the row being edited. %>
<div class="grid-2" style="margin-top:16px">
  <div class="field">
    <label for="smtp_host">SMTP host</label>
    <input id="smtp_host" name="smtp_host" type="text" value="<%= s.smtp_host || '' %>" placeholder="smtp.office365.com">
  </div>
  <div class="field">
    <label for="smtp_port">Port</label>
    <input id="smtp_port" name="smtp_port" type="number" value="<%= s.smtp_port || 587 %>">
  </div>
  <div class="field">
    <label for="smtp_user">Username</label>
    <input id="smtp_user" name="smtp_user" type="text" value="<%= s.smtp_user || '' %>" autocomplete="off">
  </div>
  <div class="field">
    <label for="smtp_pass">Password</label>
    <input id="smtp_pass" name="smtp_pass" type="password"
           placeholder="<%= s.smtp_pass_enc ? '•••••••• (leave blank to keep)' : '' %>" autocomplete="new-password">
  </div>
  <div class="field">
    <label for="from_name">Default from name</label>
    <input id="from_name" name="from_name" type="text" value="<%= s.from_name || '' %>" placeholder="<%= brand.name %>">
    <p class="hint">Used only when the sender has no name set.</p>
  </div>
  <div class="field">
    <label for="from_email">From address</label>
    <input id="from_email" name="from_email" type="email" value="<%= s.from_email || '' %>" placeholder="noreply@example.com">
    <p class="hint">Must be an address this server is allowed to send as.</p>
  </div>
</div>

<label class="check">
  <input type="checkbox" name="smtp_secure" value="1" <%= s.smtp_secure ? 'checked' : '' %>>
  <span>Use TLS from the first byte (port 465). Leave off for STARTTLS on 587.</span>
</label>

<div class="notice" style="background:var(--surface-2);border-color:var(--border);color:var(--text-2);margin-top:16px">
  <strong style="display:block;margin-bottom:5px;color:var(--text)">How a recipient sees it</strong>
  Mail is sent from the one address above, because most servers reject a From they do not own. The
  <em>display name</em> is whoever sent the document, and <strong>Reply-To is set to their own address</strong>,
  so a recipient sees a name they recognise and replies reach the right person.
</div>

<p class="hint" style="margin-top:14px">
  The password is encrypted at rest with AES-256-GCM. It has to be recoverable to authenticate to the
  mail server, so it is encrypted rather than hashed — unlike account passwords, which are hashed with
  Argon2id and can never be read back.
</p>
