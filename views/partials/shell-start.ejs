<%
  // Marks the current section. /documents/<id> should still light up Documents,
  // so a section matches on its prefix — except "/", which would match
  // everything.
  const here = (href) => href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
  const initials = String(user.display_name || '?')
    .split(/\s+/).filter(Boolean).map((w) => w[0]).join('').slice(0, 2).toUpperCase();
%>
<div class="app">
  <aside class="sidebar" id="sidebar">
    <a class="side-brand" href="/documents">
      <img src="/static/brand/logo-web.png?v=<%= v %>" alt="<%= brand.name %>" width="103" height="23">
    </a>

    <nav class="side-nav">
      <a href="/documents" class="<%= here('/documents') ? 'active' : '' %>">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path>
          <path d="M14 3v5h5"></path>
        </svg>
        Documents
      </a>
      <a href="/" class="<%= here('/') ? 'active' : '' %>">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3l7.5 3.3v5c0 4.6-3.2 8.3-7.5 9.4-4.3-1.1-7.5-4.8-7.5-9.4v-5z"></path>
          <path d="m9 12 2.2 2.2L15.5 10"></path>
        </svg>
        Verify
      </a>

      <% if (isAdmin) { %>
        <div class="side-sect">Administration</div>
        <a href="/team" class="<%= here('/team') ? 'active' : '' %>">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M16 20v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 18.5V20"></path>
            <circle cx="10" cy="8" r="3.2"></circle>
            <path d="M20 20v-1.5a3.5 3.5 0 0 0-2.6-3.4M15.4 5.2a3.2 3.2 0 0 1 0 5.6"></path>
          </svg>
          Team
        </a>
        <a href="/settings" class="<%= here('/settings') ? 'active' : '' %>">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="2.8"></circle>
            <path d="M19.4 14.5a1.6 1.6 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.6 1.6 0 0 0-1.8-.3 1.6 1.6 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.2a1.6 1.6 0 0 0-1-1.4 1.6 1.6 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.6 1.6 0 0 0 .3-1.8 1.6 1.6 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.2a1.6 1.6 0 0 0 1.4-1 1.6 1.6 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.6 1.6 0 0 0 1.8.3H9a1.6 1.6 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.2a1.6 1.6 0 0 0 1 1.4 1.6 1.6 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.6 1.6 0 0 0-.3 1.8V9a1.6 1.6 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.2a1.6 1.6 0 0 0-1.4 1z"></path>
          </svg>
          Settings
        </a>
      <% } %>
    </nav>

    <div class="side-foot">
      <div class="side-user">
        <span class="avatar" aria-hidden="true"><%= initials %></span>
        <div style="min-width:0">
          <div class="who-name"><%= user.display_name %></div>
          <div class="who-role"><%= isAdmin ? 'Administrator' : 'Member' %></div>
        </div>
      </div>
      <div class="side-actions">
        <a class="btn btn-ghost btn-sm" href="/profile" style="flex:1">Profile</a>
        <form method="post" action="/logout" style="margin:0">
          <button class="btn btn-ghost btn-sm" type="submit">Sign out</button>
        </form>
        <%- include('theme-toggle') %>
      </div>
    </div>
  </aside>

  <div class="app-main">
    <header class="app-topbar">
      <button type="button" class="icon-btn" id="sidebar-toggle" aria-label="Open navigation" aria-controls="sidebar">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
             stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
      <a class="brand" href="/documents">
        <img src="/static/brand/logo-web.png?v=<%= v %>" alt="<%= brand.name %>" width="94" height="21">
      </a>
      <%- include('theme-toggle') %>
    </header>

    <% if (typeof flash !== 'undefined' && flash) { %>
      <div class="wrap" style="padding-top:18px"><div class="flash flash-<%= flash.type %>"><%= flash.text %></div></div>
    <% } %>

    <main>
