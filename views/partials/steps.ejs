<%#
  Where the person is in a multi-page flow. `steps` is [{ label, state }] with
  state 'done', 'current' or 'todo'. Not links: going back a step mid-flow is
  not always safe (a sent document cannot be unsent), so this only shows the way.
%>
<ol class="steps<%= typeof compact !== 'undefined' && compact ? ' steps-compact' : '' %>" aria-label="Progress">
  <% steps.forEach(function (s, i) { %>
    <li class="step step-<%= s.state %>" data-step="<%= i %>" <%= s.state === 'current' ? 'aria-current=step' : '' %>>
      <span class="step-dot" aria-hidden="true">
        <svg class="step-tick" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5"></path></svg>
        <span class="step-num"><%= i + 1 %></span>
      </span>
      <span class="step-label"><%= s.label %></span>
    </li>
  <% }); %>
</ol>
