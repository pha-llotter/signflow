<%- include('partials/head', { title: 'Settings' }) %>
<%- include('partials/shell-start') %>

  <div class="wrap" style="max-width:720px">
    <div class="page-head">
      <div>
        <h1>Settings</h1>
        <p class="sub">These apply to everyone in <%= settings.name %>, not just your account.</p>
      </div>
    </div>

    <% if (saved) { %><div class="notice notice-ok" style="margin-top:0;margin-bottom:18px">Settings saved.</div><% } %>
    <% if (test) { %><div class="notice notice-ok" style="margin-top:0;margin-bottom:18px"><%= test %></div><% } %>
    <% if (error) { %><div class="notice notice-bad" style="margin-top:0;margin-bottom:18px"><%= error %></div><% } %>

    <form method="post" action="/settings">
      <div class="card">
        <h2>Organisation</h2>
        <div class="field" style="margin:14px 0 0">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" value="<%= settings.name %>" required>
          <p class="hint">Shown to your team, on invitations, and to signers alongside the sender's name.</p>
        </div>
      </div>

      <div class="card">
        <h2>Outgoing mail</h2>
        <p class="hint">Every signing invitation, reminder, completion notice and team invitation from your organisation goes out through this.</p>
        <div class="choice-cards" style="margin-top:12px">
          <label class="choice">
            <input type="radio" name="mail_source" value="platform" <%= !settings.smtp_host ? 'checked' : '' %>>
            <span><strong>Use <%= brand.name %> mail</strong><small>
              <% if (platformMail) { %>Sent through the platform's mail account. Nothing to set up.
              <% } else { %>The platform mail account has not been set up yet, so links are not emailed until it is.<% } %>
            </small></span>
          </label>
          <label class="choice">
            <input type="radio" name="mail_source" value="own" <%= settings.smtp_host ? 'checked' : '' %>>
            <span><strong>Use our own mail server</strong><small>Mail comes from your own domain, e.g. noreply@yourschool.co.za.</small></span>
          </label>
        </div>
        <div class="own-mail">
          <%- include('partials/smtp-fields', { s: settings }) %>
        </div>
      </div>

      <div class="btn-row" style="margin-top:18px">
        <button class="btn" type="submit">Save settings</button>
        <button class="btn btn-ghost" type="submit" formaction="/settings/test" formnovalidate <%= effective ? '' : 'disabled' %>>Send a test email</button>
      </div>
      <p class="hint">
        <% if (!effective) { %>No mail account is in effect yet.
        <% } else if (effective.source === 'company') { %>In effect: your own server, <%= effective.smtp_host %>.
        <% } else { %>In effect: <%= brand.name %> mail.<% } %>
        The test goes to your own address using the saved settings.
      </p>
    </form>

    <%- include('partials/logo-card', { c: settings, base: '/settings' }) %>

    <% if (settings.updated_at) { %>
      <p class="hint" style="margin-top:16px">
        Last changed <%= new Date(settings.updated_at).toLocaleString() %>. Changes are recorded in the
        <a href="/activity">activity log</a>.
      </p>
    <% } %>

  </div>
<%- include('partials/shell-end') %>
