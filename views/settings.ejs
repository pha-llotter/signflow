<%- include('partials/head', { title: 'Settings' }) %>
<%- include('partials/shell-start') %>
<%
  const mailState = !effective
    ? { tone: 'warn', text: 'No mail account in effect' }
    : effective.source === 'company'
      ? { tone: 'ok', text: 'Using your server · ' + effective.smtp_host }
      : { tone: 'ok', text: 'Using ' + brand.name + ' mail' };
%>
  <div class="wrap settings-page">
    <div class="page-head">
      <div>
        <h1>Settings</h1>
        <p class="sub">These apply to everyone in your organisation, not just your account.</p>
      </div>
    </div>

    <% if (saved) { %><div class="notice notice-ok set-notice">Settings saved.</div><% } %>
    <% if (test) { %><div class="notice notice-ok set-notice"><%= test %></div><% } %>
    <% if (error) { %><div class="notice notice-bad set-notice"><%= error %></div><% } %>

    <%# Each section is its own form with its own Save; the server only changes what was submitted. %>
    <section class="set-section">
      <div class="set-intro">
        <h2>Organisation</h2>
        <p>Shown to your team, on invitations, and to signers alongside the sender's name.</p>
      </div>
      <form method="post" action="/settings" class="card set-card">
        <div class="field" style="margin:0">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" value="<%= settings.name %>" required>
        </div>
        <div class="set-foot">
          <button class="btn btn-sm" type="submit">Save</button>
        </div>
      </form>
    </section>

    <section class="set-section">
      <div class="set-intro">
        <h2>Outgoing mail</h2>
        <p>Every signing invitation, reminder, completion notice and team invitation from your organisation goes out through this.</p>
        <span class="set-status set-status-<%= mailState.tone %>"><%= mailState.text %></span>
      </div>
      <form method="post" action="/settings" class="card set-card">
        <div class="choice-cards">
          <label class="choice">
            <input type="radio" name="mail_source" value="platform" <%= !settings.smtp_host ? 'checked' : '' %>>
            <span><strong>Use <%= brand.name %> mail</strong><small>
              <% if (platformMail) { %>Sent through the platform's mail account. Nothing to set up.
              <% } else { %>The platform mail account has not been set up yet, so links are not emailed until it is.<% } %>
            </small></span>
          </label>
          <label class="choice">
            <input type="radio" name="mail_source" value="own" <%= settings.smtp_host ? 'checked' : '' %>>
            <span><strong>Use our own mail server</strong><small>Mail comes from your own domain, e.g. noreply@yourcompany.co.za.</small></span>
          </label>
        </div>
        <div class="own-mail">
          <%- include('partials/smtp-fields', { s: settings }) %>
        </div>
        <div class="set-foot">
          <span class="set-foot-note">The test goes to your own address using the saved settings.</span>
          <button class="btn btn-ghost btn-sm" type="submit" formaction="/settings/test" formnovalidate <%= effective ? '' : 'disabled' %>>Send a test email</button>
          <button class="btn btn-sm" type="submit">Save</button>
        </div>
      </form>
    </section>

    <section class="set-section">
      <div class="set-intro">
        <h2>Logo</h2>
        <p>Printed at the top of every certificate your organisation seals, at the top of its emails and in the sidebar.</p>
        <p>PNG or JPG up to 1 MB — a few hundred KB is plenty. A wide logo on a transparent background reads best.</p>
      </div>
      <%- include('partials/logo-card', { c: settings, base: '/settings', intro: false }) %>
    </section>

    <% if (settings.updated_at) { %>
      <p class="set-meta">
        Last changed <%= new Date(settings.updated_at).toLocaleString() %> · every change is recorded in the
        <a href="/activity">activity log</a>.
      </p>
    <% } %>
  </div>
<%- include('partials/shell-end') %>
