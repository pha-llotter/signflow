<%- include('partials/head', { title: 'Signed' }) %>
<%- include('partials/nav') %>

<main>
  <div class="wrap-narrow" style="margin-top:50px">
    <div class="card" style="text-align:center;padding:40px 30px">
      <div style="font-size:42px;line-height:1">✓</div>
      <h1 style="font-size:22px;margin:12px 0 6px">Signed</h1>
      <p class="hint" style="font-size:14px">
        Your signature on <strong style="color:var(--ink)"><%= doc.title %></strong> was recorded on
        <%= new Date(recipient.signed_at).toLocaleString() %>.
      </p>

      <% if (doc.status === 'completed') { %>
        <p class="hint">Everyone has now signed. The sealed PDF and its certificate of completion have been emailed to you.</p>
        <div class="btn-row" style="justify-content:center;margin-top:20px">
          <a class="btn" href="/sign/<%= recipient.token %>/signed.pdf">Download the sealed PDF</a>
          <a class="btn btn-ghost" href="/verify/<%= doc.id %>">Verify it</a>
        </div>
        <div class="hash-box" style="margin-top:24px;text-align:left">
          <div class="k">Sealed document (SHA-256)</div>
          <div class="mono"><%= doc.sealed_sha256 %></div>
        </div>
      <% } else { %>
        <p class="hint">
          We are still waiting on the other signers. You will be emailed the sealed copy the moment the last one is in.
        </p>
      <% } %>

      <p class="hint" style="margin-top:24px;font-size:12px">
        Document ID <span class="mono"><%= doc.id %></span>
      </p>
    </div>
  </div>
</main>

<%- include('partials/foot') %>
