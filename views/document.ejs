<%- include('partials/head', { title: doc.title }) %>
<%- include('partials/shell-start') %>

  <div class="wrap">
    <div class="page-head">
      <div>
        <h1><%= doc.title %></h1>
        <p class="sub">
          <span class="pill pill-<%= doc.status %>"><%= doc.status %></span>
          · <%= doc.filename %> · <%= doc.page_count %> page<%= doc.page_count === 1 ? '' : 's' %>
          <% if (doc.expires_at && doc.status === 'sent') { %> · expires <%= new Date(doc.expires_at).toDateString() %><% } %>
        </p>
      </div>
      <div class="spacer"></div>
      <div class="btn-row">
        <% if (doc.status === 'draft') { %>
          <a class="btn btn-ghost" href="/documents/<%= doc.id %>/prepare">Edit fields</a>
          <form method="post" action="/documents/<%= doc.id %>/send" class="inline">
            <button class="btn" type="submit">Send for signature</button>
          </form>
        <% } else if (doc.status === 'sent') { %>
          <form method="post" action="/documents/<%= doc.id %>/remind" class="inline">
            <button class="btn btn-ghost" type="submit">Send a reminder</button>
          </form>
        <% } else if (doc.status === 'completed') { %>
          <a class="btn" href="/documents/<%= doc.id %>/signed.pdf">Download sealed PDF</a>
        <% } %>
        <a class="btn btn-ghost" href="/documents/<%= doc.id %>/save-template">Save as template</a>
      </div>
    </div>

    <% if (doc.status === 'completed') { %>
      <div class="card">
        <h2>Seal</h2>
        <p class="hint">Anyone can check a copy against these at <a href="/verify/<%= doc.id %>"><%= baseUrl %>/verify/<%= doc.id %></a> — no account needed.</p>
        <div class="grid-2" style="margin-top:14px">
          <div class="hash-box">
            <div class="k">Original document (SHA-256)</div>
            <div class="mono"><%= doc.original_sha256 %></div>
          </div>
          <div class="hash-box">
            <div class="k">Signed, before certificate (SHA-256)</div>
            <div class="mono"><%= doc.signed_sha256 || '—' %></div>
          </div>
          <div class="hash-box" style="grid-column:1/-1">
            <div class="k">Sealed file, certificate included (SHA-256)</div>
            <div class="mono"><%= doc.sealed_sha256 || '—' %></div>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="card">
        <h2>Document hash</h2>
        <p class="hint">Taken when the file was uploaded, before anything was placed on it.</p>
        <div class="hash-box" style="margin-top:12px">
          <div class="k">Original document (SHA-256)</div>
          <div class="mono"><%= doc.original_sha256 %></div>
        </div>
      </div>
    <% } %>

    <div class="card">
      <h2>Recipients</h2>
      <table style="margin-top:10px">
        <thead><tr><th>Name</th><th>Status</th><th>Opened</th><th>Signed</th><th>Signing link</th></tr></thead>
        <tbody>
          <% recipients.forEach(function (r) { %>
            <tr>
              <td class="td-primary"><strong><%= r.name %></strong><div class="hint"><%= r.email %></div></td>
              <td data-label="Status"><span class="pill pill-<%= r.status %>"><%= r.status %></span></td>
              <td data-label="Opened" class="hint"><%= r.viewed_at ? new Date(r.viewed_at).toLocaleString() : '—' %></td>
              <td data-label="Signed" class="hint"><%= r.signed_at ? new Date(r.signed_at).toLocaleString() : '—' %></td>
              <td data-label="Link">
                <% if (r.token && r.status !== 'signed' && doc.status === 'sent') { %>
                  <button class="link-btn copy-link" data-link="<%= baseUrl %>/sign/<%= r.token %>">Copy link</button>
                <% } else { %>
                  <span class="hint">—</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div class="card">
      <h2>Audit trail</h2>
      <p class="hint">Every event recorded against this document. This is what the certificate of completion is built from.</p>
      <ul class="audit" style="margin-top:14px">
        <% events.forEach(function (e) { %>
          <li>
            <time><%= new Date(e.created_at).toLocaleString() %></time>
            <div>
              <span class="who"><%= e.actor %></span> — <%= e.action %>
              <% if (e.detail) { %><span class="det"><%= e.detail %></span><% } %>
              <span class="det"><%= e.ip || 'no IP recorded' %></span>
            </div>
          </li>
        <% }); %>
      </ul>
    </div>

    <div class="card">
      <h2>Danger zone</h2>
      <p class="hint">Deleting removes the stored PDFs and the whole audit trail. It cannot be undone.</p>
      <form method="post" action="/documents/<%= doc.id %>/delete" style="margin-top:12px"
            onsubmit="return confirm('Delete this document, its PDFs and its audit trail permanently?')">
        <button class="btn btn-danger btn-sm" type="submit">Delete document</button>
      </form>
    </div>
  </div>

<script>
  document.querySelectorAll('.copy-link').forEach((b) => {
    b.addEventListener('click', async () => {
      await navigator.clipboard.writeText(b.dataset.link);
      const was = b.textContent;
      b.textContent = 'Copied';
      setTimeout(() => { b.textContent = was; }, 1400);
    });
  });
</script>

<%- include('partials/shell-end') %>
