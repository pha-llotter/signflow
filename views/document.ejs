<%- include('partials/head', { title: doc.title }) %>
<%- include('partials/shell-start') %>

  <div class="wrap">
    <div class="page-head">
      <div>
        <h1><%= doc.title %></h1>
        <p class="sub">
          <span class="pill pill-<%= doc.status %>"><%= doc.status %></span>
          · <%= doc.filename %> · <%= doc.page_count %> page<%= doc.page_count === 1 ? '' : 's' %>
          <% if (doc.expires_at && doc.status === 'sent') { %> · expires <%= new Date(doc.expires_at).toDateString() %><% } %>
        </p>
      </div>
      <div class="spacer"></div>
      <div class="btn-row">
        <% if (doc.deleted_at) { %>
          <%# Nothing can be sent, reminded or edited from the trash. %>
        <% } else if (doc.status === 'draft') { %>
          <a class="btn btn-ghost" href="/documents/<%= doc.id %>/prepare">Edit fields</a>
          <form method="post" action="/documents/<%= doc.id %>/send" class="inline">
            <button class="btn" type="submit">Send for signature</button>
          </form>
        <% } else if (doc.status === 'sent') { %>
          <form method="post" action="/documents/<%= doc.id %>/remind" class="inline">
            <button class="btn btn-ghost" type="submit">Send a reminder</button>
          </form>
        <% } else if (doc.status === 'completed') { %>
          <a class="btn" href="/documents/<%= doc.id %>/signed.pdf">Download sealed PDF</a>
        <% } %>
        <% if (!doc.deleted_at) { %><a class="btn btn-ghost" href="/documents/<%= doc.id %>/save-template">Save as template</a><% } %>
      </div>
    </div>

    <% if (doc.deleted_at) { %>
      <div class="notice notice-warn" style="margin-top:0;margin-bottom:18px;display:flex;align-items:center;gap:12px;flex-wrap:wrap">
        <span style="flex:1;min-width:220px">
          <strong>This document is in the trash</strong> (since <%= new Date(doc.deleted_at).toLocaleDateString() %>).
          Its signing links are closed until you restore it.
        </span>
        <form method="post" action="/documents/<%= doc.id %>/restore" class="inline">
          <button class="btn btn-sm" type="submit">Restore</button>
        </form>
        <form method="post" action="/documents/<%= doc.id %>/purge" class="inline"
              onsubmit="return confirm('Permanently delete this document, its PDFs and its audit trail? This cannot be undone.')">
          <button class="btn btn-danger btn-sm" type="submit">Delete permanently</button>
        </form>
      </div>
    <% } %>

    <% if (doc.status === 'sent' && !doc.deleted_at) {
         const DAY = 864e5;
         const next = doc.reminder_days ? new Date(Date.parse(doc.last_reminded_at || doc.sent_at) + doc.reminder_days * DAY) : null;
         const beyond = next && doc.expires_at && next > new Date(doc.expires_at); %>
      <div class="card">
        <h2>Automatic reminders</h2>
        <p class="hint">
          <% if (!doc.reminder_days) { %>
            Off. Use <b>Send a reminder</b> above to chase people by hand.
          <% } else if (beyond) { %>
            No more are due: the document expires before the next one.
          <% } else { %>
            Anyone who has not signed is sent their link again. Next round:
            <b><%= next.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' }) %></b><% if (doc.last_reminded_at) { %>; last sent <%= new Date(doc.last_reminded_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) %><% } %>.
          <% } %>
        </p>
        <form method="post" action="/documents/<%= doc.id %>/reminders" class="role-row" style="margin-top:12px;max-width:420px">
          <select id="reminder_days" name="reminder_days">
            <% reminderChoices.forEach(function (c) { %>
              <option value="<%= c[0] %>" <%= c[0] === doc.reminder_days ? 'selected' : '' %> <%= c[0] && c[0] >= expiryDays ? 'disabled' : '' %>><%= c[1] %></option>
            <% }); %>
          </select>
          <button class="btn btn-ghost btn-sm" type="submit">Save</button>
        </form>
      </div>
    <% } %>

    <% if (doc.status === 'completed') { %>
      <div class="card">
        <h2>Seal</h2>
        <p class="hint">Anyone can check a copy against these at <a href="/verify/<%= doc.id %>"><%= baseUrl %>/verify/<%= doc.id %></a> — no account needed.</p>
        <div class="grid-2" style="margin-top:14px">
          <div class="hash-box">
            <div class="k">Original document (SHA-256)</div>
            <div class="mono"><%= doc.original_sha256 %></div>
          </div>
          <div class="hash-box">
            <div class="k">Signed, before certificate (SHA-256)</div>
            <div class="mono"><%= doc.signed_sha256 || '—' %></div>
          </div>
          <div class="hash-box" style="grid-column:1/-1">
            <div class="k">Sealed file, certificate included (SHA-256)</div>
            <div class="mono"><%= doc.sealed_sha256 || '—' %></div>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="card">
        <h2>Document hash</h2>
        <p class="hint">Taken when the file was uploaded, before anything was placed on it.</p>
        <div class="hash-box" style="margin-top:12px">
          <div class="k">Original document (SHA-256)</div>
          <div class="mono"><%= doc.original_sha256 %></div>
        </div>
      </div>
    <% } %>

    <div class="card">
      <h2>Recipients</h2>
      <table style="margin-top:10px">
        <thead><tr><th>Name</th><th>Status</th><th>Opened</th><th>Signed</th><th>Signing link</th></tr></thead>
        <tbody>
          <% recipients.forEach(function (r) { %>
            <tr>
              <td class="td-primary"><strong><%= r.name %></strong><div class="hint"><%= r.email %></div></td>
              <td data-label="Status"><span class="pill pill-<%= r.status %>"><%= r.status %></span></td>
              <td data-label="Opened" class="hint"><%= r.viewed_at ? new Date(r.viewed_at).toLocaleString() : '—' %></td>
              <td data-label="Signed" class="hint"><%= r.signed_at ? new Date(r.signed_at).toLocaleString() : '—' %></td>
              <td data-label="Link">
                <% if (r.token && r.status !== 'signed' && doc.status === 'sent' && !doc.deleted_at) { %>
                  <button class="link-btn copy-link" data-link="<%= baseUrl %>/sign/<%= r.token %>">Copy link</button>
                <% } else { %>
                  <span class="hint">—</span>
                <% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div class="card">
      <h2>Audit trail</h2>
      <p class="hint">Every event recorded against this document. This is what the certificate of completion is built from.</p>
      <ul class="audit" style="margin-top:14px">
        <% events.forEach(function (e) { %>
          <li>
            <time><%= new Date(e.created_at).toLocaleString() %></time>
            <div>
              <span class="who"><%= e.actor %></span> — <%= e.action %>
              <% if (e.detail) { %><span class="det"><%= e.detail %></span><% } %>
              <span class="det"><%= e.ip || 'no IP recorded' %></span>
            </div>
          </li>
        <% }); %>
      </ul>
    </div>

    <% if (!doc.deleted_at) { %>
      <div class="card">
        <h2>Delete</h2>
        <p class="hint">Moves the document to the trash and closes its signing links. You can restore it from the trash, or delete it permanently there.</p>
        <form method="post" action="/documents/<%= doc.id %>/delete" style="margin-top:12px">
          <button class="btn btn-danger btn-sm" type="submit">Move to trash</button>
        </form>
      </div>
    <% } %>
  </div>

<script src="/static/js/copy-link.js?v=<%= v %>" defer></script>

<%- include('partials/shell-end') %>
