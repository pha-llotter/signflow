<% const isTemplate = doc.status === 'template'; %>
<%- include('partials/head', { title: (isTemplate ? 'Template · ' : 'Prepare · ') + doc.title, bodyClass: 'no-scroll' }) %>

<%- include('partials/support-banner') %>
<div class="placer" id="placer">
  <%- include('partials/steps', { compact: true, steps: isTemplate ? [
    { label: 'Upload form', state: 'done' },
    { label: 'Name the roles', state: 'done' },
    { label: 'Place fields', state: 'current' },
    { label: 'Save template', state: 'todo' },
  ] : [
    { label: doc.template_id ? 'Choose template' : 'Upload document', state: 'done' },
    { label: 'Add recipients', state: 'done' },
    { label: 'Place fields', state: 'current' },
    { label: 'Send', state: 'todo' },
  ] }) %>
  <div class="placer-bar">
    <a class="brand brand-compact" href="<%= isTemplate ? '/templates' : '/documents' %>" title="<%= isTemplate ? 'Back to templates' : 'Back to documents' %>">
      <img src="/static/brand/logo-mark.png?v=<%= v %>" alt="<%= brand.name %>" width="24" height="24">
    </a>
    <h1><% if (isTemplate) { %><span class="vis vis-<%= doc.template_visibility %>">Template</span> <% } %><%= doc.title %></h1>
    <span class="hint" id="save-state">All changes saved</span>
    <div class="spacer"></div>
    <button type="button" class="btn btn-sm placer-toggle" id="toggle-palette">+ Add field</button>
    <button type="button" class="btn btn-ghost btn-sm placer-toggle" id="toggle-inspector">Options</button>
    <%- include('partials/theme-toggle') %>
    <div class="zoombar" role="group" aria-label="Zoom">
      <button type="button" id="zoom-out" title="Zoom out (Ctrl −)" aria-label="Zoom out">−</button>
      <span id="zoom-label" aria-live="polite">100%</span>
      <button type="button" id="zoom-in" title="Zoom in (Ctrl +)" aria-label="Zoom in">+</button>
      <button type="button" id="zoom-fit" class="zoom-fit" title="Fit the page to the window (Ctrl 0)">Fit</button>
    </div>
    <label class="check" style="margin:0">
      <input type="checkbox" id="grid-toggle" checked>
      <span style="font-size:13px">Snap to grid</span>
    </label>
    <button class="btn btn-ghost btn-sm" id="save-btn" type="button"><%= isTemplate ? 'Save' : 'Save draft' %></button>
    <% if (isTemplate) { %>
      <%# Same id as the send form so the placer flushes unsaved fields before leaving. %>
      <form method="get" action="/templates" class="inline" id="send-form" data-empty-message="Place at least one field before saving the template.">
        <button class="btn btn-sm" type="submit" id="send-btn">Done</button>
      </form>
    <% } else { %>
      <form method="post" action="/documents/<%= doc.id %>/send" class="inline" id="send-form">
        <button class="btn btn-sm" type="submit" id="send-btn">Send for signature</button>
      </form>
    <% } %>
  </div>

  <aside class="palette">
    <%
      // The order people reach for them, most common first — not grouped by kind.
      const PREFERRED = ['signature', 'initials', 'textbox', 'date_signed', 'checkbox', 'name', 'email', 'title',
        'company', 'editable_date', 'label', 'hyperlink', 'dropdown', 'radio', 'image', 'drawing',
        'attachment', 'qrcode', 'stamp'];
      const ORDER = PREFERRED.filter(function (t) { return fieldTypes[t]; })
        .concat(Object.keys(fieldTypes).filter(function (t) { return PREFERRED.indexOf(t) < 0; }));
      const SHORT = { title: 'Title', editable_date: 'Editable date', radio: 'Radio', image: 'Image' };
      const ICON = {
        signature: '<path d="M3 17c3-1 4-9 6-9s1 7 3 7 2-4 4-4 1 3 3 3"/><path d="M3 21h18"/>',
        initials: '<circle cx="12" cy="12" r="9"/><path d="m9 16 3-8 3 8M10.2 13.5h3.6"/>',
        textbox: '<path d="M5 6V4h14v2M12 4v16M9 20h6"/>',
        date_signed: '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>',
        checkbox: '<rect x="4" y="4" width="16" height="16" rx="3"/><path d="m8.5 12 2.5 2.5 4.5-5"/>',
        name: '<circle cx="12" cy="8" r="4"/><path d="M4.5 20.5c1-4 4-6 7.5-6s6.5 2 7.5 6"/>',
        email: '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m3.5 7 8.5 6.5L20.5 7"/>',
        title: '<path d="M6 5h12M12 5v14M9 19h6"/>',
        company: '<rect x="5" y="3" width="14" height="18" rx="1.5"/><path d="M9 7h2M13 7h2M9 11h2M13 11h2M10.5 21v-4h3v4"/>',
        editable_date: '<rect x="3.5" y="5" width="17" height="15" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/><rect x="13" y="13.5" width="4" height="3.5" rx=".6"/>',
        label: '<path d="M3.5 12.5V4.5a1 1 0 0 1 1-1h8l8 8-9 9z"/><circle cx="8" cy="8" r="1.4"/>',
        hyperlink: '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>',
        dropdown: '<rect x="3.5" y="4" width="17" height="16" rx="2.5"/><path d="m8.5 10.5 3.5 3.5 3.5-3.5"/>',
        radio: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4" fill="currentColor"/>',
        image: '<rect x="3.5" y="4" width="17" height="16" rx="2"/><circle cx="9" cy="9.5" r="1.8"/><path d="m4 18 5-5 4 4 2.5-2.5L20 19"/>',
        drawing: '<path d="M15.5 4.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4z"/><path d="m13.5 6.5 3 3"/>',
        attachment: '<path d="m20 11.5-8 8a5 5 0 0 1-7-7l8.5-8.5a3.3 3.3 0 0 1 4.7 4.7L9.7 17.2a1.7 1.7 0 0 1-2.4-2.4L15 7"/>',
        qrcode: '<rect x="4" y="4" width="6" height="6" rx="1"/><rect x="14" y="4" width="6" height="6" rx="1"/><rect x="4" y="14" width="6" height="6" rx="1"/><path d="M14 14h2v2h-2zM18 14h2M14 20h2M18 18h2v2"/>',
        stamp: '<rect x="4" y="13" width="16" height="6" rx="1.5"/><path d="M8 13V11a4 4 0 0 1 8 0v2M7 16h10"/>',
      };
    %>
    <h3 id="recip-label"><%= isTemplate ? 'Placing fields for the role' : 'Placing fields for' %></h3>
    <div class="recip-pick">
      <select id="recip-select" aria-labelledby="recip-label">
        <% recipients.forEach(function (r) { %>
          <option value="<%= r.id %>" data-id="<%= r.id %>"><%= r.name %><%= r.email ? ' · ' + r.email : '' %></option>
        <% }); %>
      </select>
      <span class="recip-bar" id="recip-bar"></span>
    </div>

    <div class="palette-grid">
      <% ORDER.forEach(function (type) { const spec = fieldTypes[type]; %>
        <div class="chip<%= spec.fill === 'author' ? ' chip-static' : '' %>" draggable="true" data-type="<%= type %>"
             title="<%= spec.fill === 'author' ? 'Fixed by you — the signer does not fill this in' : spec.fill === 'auto' ? 'Filled in automatically when they sign' : 'The signer fills this in' %>">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
               stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><%- ICON[type] || '<rect x="4" y="7" width="16" height="10" rx="2"/>' %></svg>
          <span><%= SHORT[type] || spec.label %></span>
        </div>
      <% }); %>
    </div>
    <p class="hint palette-hint">Drag a field onto the page. Drag to move; click to configure; × to remove.</p>
  </aside>

  <div class="canvas-area grid-on" id="canvas-area">
    <!-- Guidance lives over the document because that is where the author is
         looking; a hint in the toolbar goes unread. -->
    <div class="placer-banner" id="placer-banner" hidden>
      <span id="banner-text"></span>
      <button type="button" class="banner-cancel" id="banner-cancel">Cancel</button>
    </div>

    <div class="placer-empty" id="placer-empty" hidden>
      <strong>No fields on this document yet</strong>
      <span class="only-wide">
        Drag a field from the palette on the left onto the page — or tap one, then tap the page.
      </span>
      <span class="only-narrow">
        Tap <b>Add field</b> at the top, choose what you need, then tap the spot on the page where it belongs.
      </span>
    </div>

    <div id="pages"></div>
  </div>

  <%# The right column shows the pages until a field is selected, then that field's settings. %>
  <aside class="inspector" id="inspector">
    <div class="field-panel" id="field-panel" hidden>
      <div class="panel-head">
        <h3>Field</h3>
        <button type="button" class="link-btn" id="field-done">Done</button>
      </div>
      <p class="hint" id="no-selection">Nothing selected. Click a field on the page to change it, or drag a new one across.</p>
      <div id="inspector-body" hidden></div>
    </div>
    <div class="pages-panel" id="pages-panel">
      <h3>Pages <span class="tab-count"><%= doc.page_count %></span></h3>
      <div class="thumbs" id="thumbs"></div>
    </div>
  </aside>
</div>

<script>
  window.__DOC__ = {
    id: <%- JSON.stringify(doc.id) %>,
    pdfUrl: <%- JSON.stringify('/documents/' + doc.id + '/original.pdf') %>,
    pageSizes: <%- JSON.stringify(pageSizes) %>,
    recipients: <%- JSON.stringify(recipients.map(function (r) { return { id: r.id, name: r.name, email: r.email }; })) %>,
    fields: <%- JSON.stringify(fields) %>,
    fieldTypes: <%- JSON.stringify(fieldTypes) %>,
    stampPresets: <%- JSON.stringify(stampPresets) %>
  };
</script>
<script src="/static/js/theme.js?v=<%= v %>" defer></script>
<script type="module" src="/static/js/placer.js?v=<%= v %>"></script>
</body>
</html>
